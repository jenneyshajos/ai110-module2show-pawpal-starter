classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +Scheduler scheduler
        +add_pet(pet: Pet) void
        +get_pets() List~Pet~
        +get_all_tasks() List~Task~
        +schedule_walk(pet: Pet, time: datetime, duration_min: int) Task
        +view_todays_tasks() List~Task~
        +get_daily_plan() List~Task~
    }

    class Pet {
        +String name
        +String species
        +int age
        +List~Task~ tasks
        +add_task(task: Task) void
        +get_tasks() List~Task~
    }

    class Task {
        +String description
        +String pet_name
        +String task_type
        +datetime scheduled_time
        +int duration_min
        +String frequency
        +int priority
        +bool completed
        +mark_complete() void
        +is_due_today() bool
    }

    class Scheduler {
        +List~Task~ tasks
        +add_task(pet: Pet, task: Task) void
        +schedule_walk(pet: Pet, time: datetime, duration_min: int) Task
        +get_todays_tasks() List~Task~
        +sort_by_time() List~Task~
        +build_daily_plan(available_minutes: int) List~Task~
    }

    Owner "1" --> "*" Pet : owns
    Owner "1" --> "1" Scheduler : uses
    Pet "1" --> "*" Task : has
    Scheduler "1" --> "*" Task : manages
